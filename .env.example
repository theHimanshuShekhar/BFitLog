NODE_ENV=development
POSTGRES_USER=bfitlog
POSTGRES_PASSWORD=bfitlog
POSTGRES_DB=bfitlog
PORT=3000

# Canonical app/API origin. Docker Compose reuses this for BETTER_AUTH_URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Docker Compose derives DATABASE_URL from POSTGRES_* for the app container.
# Use a direct host DATABASE_URL only when running API/migrations outside Docker.

BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_SECURE_COOKIES=false

# Local dev clients may run on Expo web ports in addition to the API origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,bfitlog://
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
